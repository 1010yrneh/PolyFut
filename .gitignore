# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# Model weights (download on first run)
*.pt
*.onnx
*_openvino_model/
models/

# Runtime data
uploads/
exports/
server_exports/
output/
output_v2*/
_v2*.mp4
_v2*.json

# Large sample media (keep labels, not videos)
sample_data/*.mp4
sample_data/*.mov
sample_data/*.avi

# OS
.DS_Store
Thumbs.db

# Editor / local debug
.cursor/

# Release artifacts (host on polyfut.com, not in git)
website/downloads/*.exe

# Local notebooks (exploratory, carry output cruft)
notebooks/

# AI proxy wiring: holds the deployed Modal URL + shared app token. Not the Groq
# key (that lives only in Modal's secret store), but still not for git — it is
# per-deployment and rotating it shouldn't mean a commit.
ai_config.json

# Per-user runtime settings (the kit-vision opt-out lives here). Written to
# DATA_ROOT, which is %APPDATA%\PolyFut in a packaged build but the repo root
# when running from source - so without this, running the app dirties the tree.
settings.json
